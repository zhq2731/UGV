<launch>
  <!-- 手动闭环检查入口；沿用原泊车仿真，只覆盖测试地图和可选超时回退。 -->
  <arg name="rviz" default="false"/>
  <arg name="force_search_fallback" default="false"/>
  <include file="$(find launch_node)/launch/open-space-parking-simulate.launch">
    <arg name="rviz" value="$(arg rviz)"/>
    <arg name="vehicle_platform_file"
         value="$(find launch_node)/../../platform_files/vehicle_platform-tank-1.yaml"/>
  </include>
  <param name="/planner/liom_enabled" value="true"/>
  <group if="$(arg force_search_fallback)">
    <!-- 仅本次检查强制优化超时，不修改泊车常规参数文件。 -->
    <param name="/planner/liom_time_budget_ms" value="0.01"/>
  </group>
  <param name="/simulate/mapParams_resolution" value="0.1"/>
  <param name="/simulate/parking_obstacle_length" value="2.0"/>
  <param name="/simulate/parking_obstacle_width" value="4.0"/>
  <param name="/trajectory_follower/enable_control_log" value="false"/>
</launch>
