<launch>
  <!-- Three vehicles, thirteen tasks, independent global routes, RViz display. -->
  <arg name="vehicle_type" default="tank500"/>
  <arg name="vehicle_1_ns" default="vehicle_1"/>
  <arg name="vehicle_2_ns" default="vehicle_2"/>
  <arg name="vehicle_3_ns" default="vehicle_3"/>
  <arg name="vehicle_1_platform_file" default="UGV/platform_files/vehicle_platform-tank-1.yaml"/>
  <arg name="vehicle_2_platform_file" default="UGV/platform_files/vehicle_platform-tank-2.yaml"/>
  <arg name="vehicle_3_platform_file" default="UGV/platform_files/vehicle_platform-tank-3.yaml"/>
  <arg name="rviz" default="true"/>
  <arg name="wait_for_start" default="true"/>

  <arg name="offline_points_file" default="$(find task_scheduler)/config/offline_points_50.csv"/>
  <arg name="distance_table_file" default="$(find task_scheduler)/config/offline_distance_table_50.csv"/>
  <arg name="vehicles_file" default="$(find task_scheduler)/config/vehicles_3.csv"/>
  <arg name="tasks_file" default="$(find task_scheduler)/config/tasks_13.csv"/>

  <include file="$(find launch_node)/launch/three-vehicle-distributed-simulate.launch">
    <arg name="vehicle_type" value="$(arg vehicle_type)"/>
    <arg name="vehicle_1_ns" value="$(arg vehicle_1_ns)"/>
    <arg name="vehicle_2_ns" value="$(arg vehicle_2_ns)"/>
    <arg name="vehicle_3_ns" value="$(arg vehicle_3_ns)"/>
    <arg name="vehicle_1_platform_file" value="$(arg vehicle_1_platform_file)"/>
    <arg name="vehicle_2_platform_file" value="$(arg vehicle_2_platform_file)"/>
    <arg name="vehicle_3_platform_file" value="$(arg vehicle_3_platform_file)"/>
  </include>

  <group if="$(arg rviz)">
    <node pkg="rviz" type="rviz" name="rviz"
          args="-d $(find launch_node)/param/rviz/task_scheduler_3vehicle_13tasks_display.rviz"
          required="true"/>
  </group>

  <include file="$(find task_scheduler)/launch/task_scheduler.launch">
    <arg name="map_file" value="$(find launch_node)/data/cloudmap.osm"/>
    <arg name="offline_points_file" value="$(arg offline_points_file)"/>
    <arg name="vehicles_file" value="$(arg vehicles_file)"/>
    <arg name="tasks_file" value="$(arg tasks_file)"/>
    <arg name="output_file" value="/tmp/ugv_schedule_solution_3v13t.csv"/>
    <arg name="distance_table_file" value="$(arg distance_table_file)"/>
    <arg name="population" value="180"/>
    <arg name="generations" value="500"/>
    <arg name="seed" value="13"/>
    <arg name="publish_result" value="true"/>
    <arg name="keep_alive_after_publish" value="true"/>
    <arg name="wait_for_start" value="$(arg wait_for_start)"/>
    <arg name="publish_initial_delay_sec" value="0.0"/>
    <arg name="publish_repeat_count" value="6"/>
    <arg name="publish_repeat_interval_sec" value="3.0"/>
    <arg name="marker_color_scheme" value="blue_yellow_red"/>
  </include>
</launch>
