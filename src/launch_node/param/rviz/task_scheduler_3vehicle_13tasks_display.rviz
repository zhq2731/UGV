Panels:
  - Class: rviz/Displays
    Help Height: 78
    Name: Displays
    Property Tree Widget:
      Expanded:
        - /Global Options1
        - /Task Assignments1
        - /Vehicle 1 Path (Blue)1
        - /Vehicle 2 Path (Yellow)1
        - /Vehicle 3 Path (Red)1
      Splitter Ratio: 0.5
    Tree Height: 101
  - Class: rviz/Tool Properties
    Expanded: ~
    Name: Tool Properties
    Splitter Ratio: 0.550000011920929
  - Class: launch_node/ThreeVehicleMotionPanel
    Name: Motion Commands
  - Class: rviz/Views
    Expanded:
      - /Current View1
    Name: Views
    Splitter Ratio: 0.5
  - Class: rviz/Time
    Name: Time
    SyncMode: 0
    SyncSource: ""
Preferences:
  PromptSaveOnExit: false
Toolbars:
  toolButtonStyle: 2
Visualization Manager:
  Class: ""
  Displays:
    - Alpha: 0.5
      Cell Size: 1
      Class: rviz/Grid
      Color: 160; 160; 164
      Enabled: true
      Line Style:
        Line Width: 0.029999999329447746
        Value: Lines
      Name: Grid
      Normal Cell Count: 0
      Offset:
        X: 0
        Y: 0
        Z: 0
      Plane: XY
      Plane Cell Count: 20
      Reference Frame: <Fixed Frame>
      Value: true
    - Class: rviz/MarkerArray
      Enabled: true
      Marker Topic: /task_scheduler/task_markers
      Name: Task Assignments
      Namespaces:
        /task_scheduler/pending/labels: true
        /task_scheduler/pending/tasks: true
      Queue Size: 100
      Value: true
    - Class: rviz/MarkerArray
      Enabled: true
      Marker Topic: /vehicle_1/route_display
      Name: Road Network
      Namespaces:
        /Osm/points: true
        /Osm/pointsNormal: false
        /Osm/points_cross: true
        /Osm/way: true
      Queue Size: 100
      Value: true
    - Class: rviz/MarkerArray
      Enabled: true
      Marker Topic: /vehicle_1/route_display
      Name: Vehicle 1 Path (Blue)
      Namespaces:
        /Osm/points: false
        /Osm/pointsNormal: false
        /Osm/points_cross: false
        /Osm/way: false
      Queue Size: 100
      Value: true
    - Class: rviz/MarkerArray
      Enabled: true
      Marker Topic: /vehicle_2/route_display
      Name: Vehicle 2 Path (Yellow)
      Namespaces:
        /Osm/points: false
        /Osm/pointsNormal: false
        /Osm/points_cross: false
        /Osm/way: false
      Queue Size: 100
      Value: true
    - Class: rviz/MarkerArray
      Enabled: true
      Marker Topic: /vehicle_3/route_display
      Name: Vehicle 3 Path (Red)
      Namespaces:
        /Osm/points: false
        /Osm/pointsNormal: false
        /Osm/points_cross: false
        /Osm/way: false
      Queue Size: 100
      Value: true
    - Class: rviz/MarkerArray
      Enabled: false
      Marker Topic: /vehicle_1/rviz/reference_marker
      Name: Vehicle 1 Reference (Blue)
      Namespaces:
        {}
      Queue Size: 100
      Value: false
    - Class: rviz/MarkerArray
      Enabled: false
      Marker Topic: /vehicle_2/rviz/reference_marker
      Name: Vehicle 2 Reference (Yellow)
      Namespaces:
        {}
      Queue Size: 100
      Value: false
    - Class: rviz/MarkerArray
      Enabled: false
      Marker Topic: /vehicle_3/rviz/reference_marker
      Name: Vehicle 3 Reference (Red)
      Namespaces:
        {}
      Queue Size: 100
      Value: false
    - Class: rviz/MarkerArray
      Enabled: false
      Marker Topic: /vehicle_1/rviz/planning_marker
      Name: Vehicle 1 Local Planning (Blue)
      Namespaces:
        {}
      Queue Size: 100
      Value: false
    - Class: rviz/MarkerArray
      Enabled: false
      Marker Topic: /vehicle_2/rviz/planning_marker
      Name: Vehicle 2 Local Planning (Yellow)
      Namespaces:
        {}
      Queue Size: 100
      Value: false
    - Class: rviz/MarkerArray
      Enabled: false
      Marker Topic: /vehicle_3/rviz/planning_marker
      Name: Vehicle 3 Local Planning (Red)
      Namespaces:
        {}
      Queue Size: 100
      Value: false
  Enabled: true
  Global Options:
    Background Color: 48; 48; 48
    Default Light: true
    Fixed Frame: map
    Frame Rate: 30
  Name: root
  Tools:
    - Class: rviz/Interact
      Hide Inactive Objects: true
    - Class: rviz/MoveCamera
    - Class: rviz/Select
    - Class: rviz/FocusCamera
    - Class: rviz/Measure
    - Class: rviz/SetGoal
      Topic: /vehicle_1/move_base_simple/goal
    - Class: rviz/PublishPoint
      Single click: true
      Topic: /vehicle_1/clicked_point
    - Class: rviz/SetGoal
      Topic: /vehicle_2/move_base_simple/goal
    - Class: rviz/PublishPoint
      Single click: true
      Topic: /vehicle_2/clicked_point
    - Class: rviz/SetGoal
      Topic: /vehicle_3/move_base_simple/goal
    - Class: rviz/PublishPoint
      Single click: true
      Topic: /vehicle_3/clicked_point
  Value: true
  Views:
    Current:
      Angle: -2.8250045776367188
      Class: rviz/TopDownOrtho
      Enable Stereo Rendering:
        Stereo Eye Separation: 0.05999999865889549
        Stereo Focal Distance: 1
        Swap Stereo Eyes: false
        Value: false
      Invert Z Axis: false
      Name: Current View
      Near Clip Distance: 0.009999999776482582
      Scale: 1.090254783630371
      Target Frame: map
      X: -185.9580535888672
      Y: -228.8619384765625
    Saved: ~
Window Geometry:
  Displays:
    collapsed: false
  Height: 1016
  Hide Left Dock: false
  Hide Right Dock: true
  Motion Commands:
    collapsed: false
  QMainWindow State: 
  Time:
    collapsed: false
  Tool Properties:
    collapsed: false
  Views:
    collapsed: false
  Width: 1848
  X: 72
  Y: 27
