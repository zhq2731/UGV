CM_ SG_ 2566841127 EC_EM1_EngSpdAtPoint1 "Stationary low idle speed of engine which includes influences due to engine temperature (after powerup) and other stationary changes (calibration offsets, sensor failures, etc).This parameter is point 1 ofthe engine configuration map";
CM_ SG_ 2566841127 EC_EM1_EngReferenceTrq "This parameter is the 100% reference value for all defined indicated engine torque parameters. It isonly defined once and doesn't change if a different engine torque map becomes valid.";
CM_ SG_ 2566841127 EC_EM1_SupportVariableRateTSC1 "This parameter indicates which TSC1 transmission rates are supported by the engine ECU in additionto the required 10ms transmission rate for temporary powertrain control purposes. Suggest to send 0xEF.";
CM_ SG_ 2566894099 EPS1_SteerWheelAng "方向盘转向角度，用于表示方向盘实际角度大小";
CM_ SG_ 2566894099 EPS1_MotorAssistTrq "电机助力扭矩，用于表示电机助力扭矩";
CM_ SG_ 2566894099 EPS1_SteerAngSpd "方向盘反馈角速度，用于表示方向盘角速度";
CM_ SG_ 2566894099 EPS1_HandTrq "手力矩信号，用于表示手力矩";
CM_ SG_ 2566894099 EPS1_EPSStat "EPS控制器状态，表示EPS目前状态";
CM_ SG_ 2566894099 EPS1_MessageCounter "报文计数器用于检测由于报文发送者故障导致重复发生同一帧报文。报文接收者可以使用报文计数器检测到这种情况。报文发送者在每个报文发送周期令报文计数器增1，报文计时器从0开始计数直到15，然后再从0开始计数";
CM_ SG_ 2566894099 EPS1_MessageChecksum "报文校验和用于验证从发送设备到接收设备的信号传输路径。校验和是下述数据的和：报文ID由高字节至低字节的和、数据区前7个字节以及报文计数器。校验和计算公式如下：校验和 = (字节1 + 字节2 + 字节3 + 字节4 + 字节5 + 字节6 + 字节7 + 报文计数器 &0x0F + 报文ID低字节 + 报文ID中低字节 + 报文ID中高字节 + 报文ID高字节)校验和 = ((校验和 >> 4) + 校验和) & 0x0F";
CM_ SG_ 2566893862 ADV_EPS_TargetSteerWheelCmd "目标方向盘转向指令角度,用于表示目标方向盘指令角度";
CM_ SG_ 2566893862 ADV_EPS_OperateMode "表示ADV对EPS工作模式指令";
CM_ SG_ 2566893862 ADV_EPS_ADVStatus "ADV状态";
CM_ SG_ 2566893862 ADV_EPS_SteerAngleStat "转向角指令状态";
CM_ SG_ 2566893862 ADV_EPS_SteerAdditionalTrq "转向叠加扭矩信号";
CM_ SG_ 2566893862 ADV_EPS_SteerAngSpd "方向盘目标角速度，实际取值范围50~540";
CM_ SG_ 2566893862 ADV_EPS_MessageCounter "报文计数器用于检测由于报文发送者故障导致重复发生同一帧报文。报文接收者可以使用报文计数器检测到这种情况。报文发送者在每个报文发送周期令报文计数器增1，报文计时器从0开始计数直到15，然后再从0开始计数。";
CM_ SG_ 2566893862 ADV_EPS_MessageChecksum "报文校验和用于验证从发送设备到接收设备的信号传输路径。校验和是下述数据的和：报文ID由高字节至低字节的和、数据区前7个字节以及报文计数器。校验和计算公式如下：校验和 = (字节1 + 字节2 + 字节3 + 字节4 + 字节5 + 字节6 + 字节7 + 报文计数器 &0x0F + 报文ID低字节 + 报文ID中低字节 + 报文ID中高字节 + 报文ID高字节)校验和 = ((校验和 >> 4) + 校验和) & 0x0F";
