Panels:
  - Class: rviz/Displays
    Name: Displays
Visualization Manager:
  Class: ""
  Displays:
    - Alpha: 0.5
      Cell Size: 1
      Class: rviz/Grid
      Color: 150; 150; 155
      Enabled: true
      Line Style:
        Line Width: 0.03
        Value: Lines
      Name: Grid
      Plane: XY
      Plane Cell Count: 60
      Reference Frame: <Fixed Frame>
      Value: true
    - Class: rviz/MarkerArray
      Enabled: true
      Marker Topic: /structured_road/markers
      Name: Structured Road
      Namespaces:
        center_lines: true
        road_surface: true
      Queue Size: 100
      Value: true
    - Class: rviz/Path
      Color: 40; 110; 255
      Enabled: true
      Line Style: Lines
      Line Width: 0.14
      Name: Vehicle 1 Path
      Offset:
        X: 0
        Y: 0
        Z: 0.12
      Pose Style: None
      Topic: /vehicle_1/planned_path
      Unreliable: false
      Value: true
    - Class: rviz/Path
      Color: 255; 80; 80
      Enabled: true
      Line Style: Lines
      Line Width: 0.14
      Name: Vehicle 2 Path
      Offset:
        X: 0
        Y: 0
        Z: 0.16
      Pose Style: None
      Topic: /vehicle_2/planned_path
      Unreliable: false
      Value: true
    - Class: rviz/Path
      Color: 30; 180; 85
      Enabled: true
      Line Style: Lines
      Line Width: 0.14
      Name: Vehicle 3 Path
      Offset:
        X: 0
        Y: 0
        Z: 0.20
      Pose Style: None
      Topic: /vehicle_3/planned_path
      Unreliable: false
      Value: true
    - Class: rviz/Path
      Color: 230; 140; 40
      Enabled: true
      Line Style: Lines
      Line Width: 0.14
      Name: Vehicle 4 Path
      Offset:
        X: 0
        Y: 0
        Z: 0.24
      Pose Style: None
      Topic: /vehicle_4/planned_path
      Unreliable: false
      Value: true
    - Class: rviz/MarkerArray
      Enabled: true
      Marker Topic: /vehicle_1/vehicle_markers
      Name: Vehicle 1
      Namespaces:
        vehicle_1: true
      Queue Size: 100
      Value: true
    - Class: rviz/MarkerArray
      Enabled: true
      Marker Topic: /vehicle_2/vehicle_markers
      Name: Vehicle 2
      Namespaces:
        vehicle_2: true
      Queue Size: 100
      Value: true
    - Class: rviz/MarkerArray
      Enabled: true
      Marker Topic: /vehicle_3/vehicle_markers
      Name: Vehicle 3
      Namespaces:
        vehicle_3: true
      Queue Size: 100
      Value: true
    - Class: rviz/MarkerArray
      Enabled: true
      Marker Topic: /vehicle_4/vehicle_markers
      Name: Vehicle 4
      Namespaces:
        vehicle_4: true
      Queue Size: 100
      Value: true
    - Class: rviz/MarkerArray
      Enabled: true
      Marker Topic: /trajectory_conflict/markers
      Name: Conflict State
      Namespaces:
        collision_point: true
        conflict_s_boundaries: true
        conflict_s_intervals: true
        conflict_state: true
        vehicle_1_prediction: true
        vehicle_2_prediction: true
      Queue Size: 100
      Value: true
    - Class: rviz/TF
      Enabled: true
      Frame Timeout: 15
      Frames:
        All Enabled: true
      Marker Scale: 0.7
      Name: TF
      Show Arrows: true
      Show Axes: true
      Show Names: false
      Update Interval: 0
      Value: true
  Enabled: true
  Global Options:
    Background Color: 245; 246; 248
    Default Light: true
    Fixed Frame: map
    Frame Rate: 30
  Name: root
  Tools:
    - Class: rviz/Interact
      Hide Inactive Objects: true
    - Class: rviz/MoveCamera
    - Class: rviz/Select
  Value: true
  Views:
    Current:
      Class: rviz/TopDownOrtho
      Distance: 60
      Name: Current View
      Near Clip Distance: 0.01
      Scale: 44
      Target Frame: <Fixed Frame>
      Value: TopDownOrtho (rviz)
      X: 0
      Y: 0
    Saved: ~
Window Geometry:
  Displays:
    collapsed: false
  Height: 900
  Width: 1400
  X: 40
  Y: 40
